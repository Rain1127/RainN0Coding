[Unit]
Description=RainN0Coding rootless Harness executor
Wants=network-online.target
Requires=user@%i.service
After=network-online.target user@%i.service

[Service]
Type=simple
Delegate=yes
Environment=XDG_RUNTIME_DIR=/run/user/%i
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%i/bus
EnvironmentFile=/etc/rainn0coding/harness-executor.env
ExecStart=/usr/bin/unshare --mount --propagation private /opt/rainn0coding/harness-executor/launch-rootless.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027

[Install]
WantedBy=multi-user.target
