# Copy to runtime.env on the server, restrict it to the operator account, and
# replace every blank secret before starting any container.
APP_RELEASE=initial
PUBLIC_ORIGIN=https://example.invalid
PUBLIC_HTTP_PORT=80

MYSQL_DATABASE=rainn0coding
MYSQL_USER=rain
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_URL=jdbc:mysql://mysql:3306/rainn0coding

POSTGRES_DB=litellm_gateway
POSTGRES_USER=litellm
POSTGRES_PASSWORD=

REDIS_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379

LITELLM_MASTER_KEY=
LITELLM_API_KEY=
LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_HEALTH_URL=http://litellm:4000/health/liveliness
LLM_REASONING_MODEL=code-reasoning
LLM_STRUCTURED_MODEL=code-structured
LLM_LIGHTWEIGHT_MODEL=code-lightweight
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_REASONING_MODEL=deepseek/deepseek-v4-pro
DEEPSEEK_CHAT_MODEL=deepseek/deepseek-chat
ZHIPUAI_API_KEY=
ZHIPUAI_API_BASE=https://open.bigmodel.cn/api/paas/v4
ZHIPUAI_MODEL=zai/glm-4.7-flash

PYTHON_AI_BASE_URL=http://python-agent:8000
PYTHON_AI_INTERNAL_TOKEN=
APP_ENV=production
AGENT_MAX_CONCURRENT_REQUESTS=2
PYTHON_WORKERS=1
VECTOR_DB_PROVIDER=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
LOCAL_EMBEDDING_ENABLED=true
CODE_OUTPUT_DIR=/data/code-output
SQLITE_DB_PATH=/data/rag/exact_search.db

APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://example.invalid
APP_DEPLOY_HOST=https://example.invalid/api/static
JAVA_XMS=512m
JAVA_XMX=1536m

OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
